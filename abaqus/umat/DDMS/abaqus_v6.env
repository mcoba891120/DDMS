import os

# set these before invoking abaqus, e.g.:
#   export LIBTORCH_DIR=/path/to/libtorch
#   export LIBTORCHSCATTER_DIR=/path/to/pytorch_scatter
#   export LIBTORCHSPARSE_DIR=/path/to/pytorch_sparse
libtorch = os.environ.get('LIBTORCH_DIR', '')
libtorchscatter = os.environ.get('LIBTORCHSCATTER_DIR', '')
libtorchsparse = os.environ.get('LIBTORCHSPARSE_DIR', '')
fortCmd = "ifort"
cppCmd = "icpc"

link_sl = (fortCmd +
 " -cxxlib -fPIC -threads -shared " +
 "%E -Wl,-soname,%U -o %U %F %A %L %B -parallel -Wl,-Bdynamic " +
 "-i-dynamic -lifport -lifcoremt " +
 libtorch + "/lib/libtorch_cpu.so " +
 libtorch + "/lib/libc10.so " +
 libtorchscatter + "/lib64/libtorchscatter.so " +
 libtorchsparse + "/lib64/libtorchsparse.so ")
 
 
link_exe = (cppCmd + " -cxxlib -fPIC " +
 "-Wl,-Bdynamic -o %J %F %M %L %B %O -lpthread " +
 libtorch + "/lib/libtorch_cpu.so " +
 libtorch + "/lib/libc10.so " +
 libtorchscatter + "/lib64/libtorchscatter.so " +
 libtorchsparse + "/lib64/libtorchsparse.so ")

# required for abaqus/explicit
double_precision=BOTH

del cppCmd
del fortCmd
del libtorch
del libtorchscatter
del libtorchsparse