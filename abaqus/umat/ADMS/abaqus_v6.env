# Linux (Opteron/EM64T) Settings:
#
# Compile and Link command for user subroutines.
# Compile_cpp and link_exe for Abaqus make utility.
#
import os, re, glob, driverUtils

# set DAMASK_BUILD_DIR / PETSC_BUILD_DIR before invoking abaqus, e.g.:
#   export DAMASK_BUILD_DIR=/path/to/build-grid
#   export PETSC_BUILD_DIR=/path/to/petsc/arch-linux-c-opt
damask = os.environ.get('DAMASK_BUILD_DIR', '')
petsc = os.environ.get('PETSC_BUILD_DIR', '')
fortCmd = "ifort"
mpiCmd = "/usr/lib64/openmpi/bin/mpif90"

# -free                           to use free-format FORTRAN 90 syntax
# -O <0-3>                        optimization level
# -fpp                            use FORTRAN preprocessor on source code
# -fopenmp                        build with openMP support
# -w90 -w95                       suppress messages about use of non-standard Fortran (previous version of abaqus_v6.env only)
# -WB                             turn a compile-time bounds check into a warning (previous version of abaqus_v6.env only)
# -mP2OPT_hpo_vec_divbyzero=F     inofficial compiler switch, proposed by abaqus but highly dubios (previous version of abaqus_v6.env only)
# -ftz                            flush underflow to zero
# -diag-disable 5268              disable warnings about line length > 132 (only comments there anyway)
# -implicitnone                   assume no implicit types (e.g. i for integer)
# -standard-semantics             sets standard (Fortran 2008) and some other conventions
# -assume nostd_mod_proc_name     avoid problems with libraries compiled without that option
# -real-size 64                   assume size of real to be 8 bytes, matches our definition of pReal

# compile_fortran = (fortCmd + " -c -fPIC -auto -shared-intel " +
#                    "-I%I -free -O3 -fpp -fopenmp " +
#                    "-ftz -diag-disable 5268 " +
#                    "-implicitnone -standard-semantics " +
#                    "-assume nostd_mod_proc_name " +
#                    "-real-size 64 " +
#                    '-DDAMASKVERSION=\\\"n/a\\\"')

link_sl = (fortCmd + " -cxxlib -fPIC -threads " + 
            "%E -Wl,-soname,%U -parallel -Wl,-Bdynamic -o %U %F %A %L %B " +
            damask + "/src/CMakeFiles/DAMASK_grid.dir/CPFEM2.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/C_routines.c.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/DAMASK_interface.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/HDF5_utilities.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/IO.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/LAPACK_interface.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/YAML_parse.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/YAML_types.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/base64.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/config.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/discretization.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/element.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/geometry_plastic_nonlocal.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_damage.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_damage_pass.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_mechanical.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_mechanical_RGC.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_mechanical_isostrain.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_mechanical_pass.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_thermal.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_thermal_isotemperature.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/homogenization_thermal_pass.f90.o " + 
