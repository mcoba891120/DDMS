            damask + "/src/CMakeFiles/DAMASK_grid.dir/phase_mechanical_eigen_cleavageopening.f90.o " + 
            damask + "/src/CMakeFiles/DAMASK_grid.dir/phase_mechanical_eigen_thermalexpansion.f90.o " + 
